// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                Int          @id @default(autoincrement())
  email             String       @unique
  linkedinId        String?      @unique
  linkedinUrl       String?
  name              String?
  profilePictureUrl String?
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  profile           UserProfile?
  favorites         Favorite[]
}

model UserProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id])
  summary     String?
  skills      String[]
  interests   String[]
  iceBreakers String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Favorite {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  linkedinUrl String
  createdAt   DateTime @default(now())
}
